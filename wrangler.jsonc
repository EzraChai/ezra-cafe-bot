{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ezra-cafe-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "d1_databases": [
    {
      "binding": "DB_BINDING",
      "database_name": "ezra_coffee",
      "database_id": "5d9ae631-d795-4204-8820-ad28252f14b9",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/*.sql",
    },
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": false,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
